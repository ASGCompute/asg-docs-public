{
    "$schema": "https://mintlify.com/schema.json",
    "name": "ASG Agent Cloud",
    "logo": {
        "dark": "/logo/dark.svg",
        "light": "/logo/light.svg"
    },
    "favicon": "/favicon.svg",
    "colors": {
        "primary": "#6366F1",
        "light": "#818CF8",
        "dark": "#4F46E5",
